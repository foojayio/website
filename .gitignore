# Hugo
/public/
/resources/_gen/
.hugo_build.lock

# JBang
.jbang/

# IDE
.idea/
*.iml

# OS
.DS_Store

# Logs from conversion scripts
scripts/*.log

# Wrangler (the view counter Worker -- worker/views/)
node_modules/
.wrangler/

# Python (cleanup/images.py is the one Python script here -- see its header)
__pycache__/

# In-flight staging from cleanup/images.py. It encodes to a temp path and renames
# only once the result is verified, so a killed run can leave these behind. They
# must never be committed: an earlier run left a half-written 0-byte .webp, it got
# committed, and the "destination already exists" guard then refused to ever
# convert that GIF again.
*.webp.tmp
*.webp.best
*.jpg.tmp
*.png.tmp
*.jpeg.tmp

# Download cache for scripts/fetch/PodcastTranscripts.java -- the raw YouTube
# caption files. Not committed: the transcript in the page bundle is the
# artefact, and these are re-fetchable.
.cache/

# Playwright (tests/e2e/) -- the browser checks that run against the BUILT site.
# .pages.json is regenerated from public/ at the start of every run (see
# tests/e2e/discover.mjs), so committing it would only freeze a stale answer.
/test-results/
/playwright-report/
tests/e2e/.pages.json
# The staging half of that write -- present only mid-rename, but a killed run
# leaves one behind and a 0-byte file committed here is the images.py lesson.
tests/e2e/.pages.json.tmp
