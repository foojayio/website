{{- /*
An author's feed: the articles they are credited on, newest first.

Hugo's embedded RSS template only ranges over `.Pages`/`.RegularPages`, which
an author profile does not have -- so without this override, turning `rss` on
for them renders an empty <channel>.

Articles come from partials/author-posts.html, the single definition of
"this author's articles" -- so the feed cannot credit an author differently
from their own profile page.
*/ -}}
{{- $written := partial "author-posts.html" . }}
{{- $limit := .Site.Config.Services.RSS.Limit }}
{{- if ge $limit 1 }}{{ $written = $written | first $limit }}{{ end }}
{{- /* `{{-`, not `{{`: an XML declaration is only a declaration at byte 0,
       and every line above is a template action followed by a newline.
       Without the trim the feed opens with a blank line and a strict parser
       rejects the file -- invisibly, since a lenient reader takes it. */ -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Title }} on {{ .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>Articles written by {{ .Title }} on {{ .Site.Title }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    {{ with .Site.Copyright }}<copyright>{{ . }}</copyright>{{ end }}
    {{ if $written }}
      <lastBuildDate>{{ (index $written 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{ end }}
    {{- with .OutputFormats.Get "RSS" }}
      {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $written }}
      <item>
        <title>{{ .Title }}</title>
        <link>{{ .Permalink }}</link>
        <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
        <guid>{{ .Permalink }}</guid>
        <description>{{ .Summary | transform.XMLEscape | safeHTML }}</description>
      </item>
    {{- end }}
  </channel>
</rss>
