{{- /* Hugo's embedded sitemap, minus pages whose `canonical:` names another
       URL: listing a page that declares someone else the original is a mixed
       signal, and 900 cross-posts did exactly that. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range .Data.Pages }}
    {{- if and .Permalink (or (not .Params.canonical) (eq .Params.canonical .Permalink)) }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>{{ end }}
  </url>
    {{- end }}
  {{- end }}
</urlset>
