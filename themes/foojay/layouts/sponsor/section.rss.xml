{{- /*
  A sponsor's feed: the articles attributed to that sponsor, newest first.

  A sponsor bundle is a section only so .Paginate will take it, and it has no
  CHILD pages -- so Hugo's embedded RSS template ranges over nothing and ships
  an EMPTY <channel>, advertised in <head>. See author/section.rss.xml for the
  same trap.

  So the feed lists what the PAGE lists: partials/sponsor-posts.html is the one
  definition of "a sponsor's articles", from:/till: windows included, so the
  feed cannot credit the sponsor with an article their page does not show.
*/ -}}
{{- $posts := partial "sponsor-posts.html" . -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 }}{{ $posts = $posts | first $limit }}{{ end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Title }} on {{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>Articles from {{ .Title }} on {{ site.Title }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    {{ with site.Copyright }}<copyright>{{ . }}</copyright>{{ end }}
    {{- with (index $posts 0) }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "rss" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q/>" .Permalink .MediaType.Type | safeHTML }}
    {{- end }}
    {{- range $posts }}
    <item>
      <title>{{ .Title | transform.XMLEscape | safeHTML }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- range .Params.categories }}
      <category>{{ . | transform.XMLEscape | safeHTML }}</category>
      {{- end }}
      <guid>{{ .Permalink }}</guid>
      <description>{{ partial "meta-description.html" . | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
