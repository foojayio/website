{{- /*
  /java-champions/'s feed: every Java Champion, newest class first.

  A `page` kind, so it needs an `outputs:` line in its content file and this
  template -- see events/single.rss.xml for why config cannot hand a feed to
  one page.

  WHAT IS SUBSCRIBABLE HERE IS AN ADDITION: a champion is named once and
  stays, so the news is "someone new was recognised". Hence:

  - EVERY CHAMPION IS IN THE FEED, deliberately ignoring [services.rss] limit.
    Capped at 30 the feed would be the last two intakes, and a BACKFILL -- a
    champion added upstream with an earlier year, which happens -- would never
    appear at all. ~120 KB, and an unchanged poll gets a 304.
  - pubDate IS THE YEAR THEY WERE NAMED, so newest-first agrees with the
    document order. 1 January is a convention for a year-granular fact, since
    RSS has no year-only date; stamping the build time instead would put one
    identical date on facts from different years. Through time.AsTime rather
    than printf, so the weekday name is correct.

  Ordered by `year` descending then name -- the intake order, NOT the table's
  A-Z, which is how you look someone up rather than how a feed is read.
*/ -}}
{{- $champions := index hugo.Data "java-champions" -}}
{{- $champions = sort (sort $champions "name") "year" "desc" -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Title }} on {{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ partial "meta-description.html" . }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    {{ with site.Copyright }}<copyright>{{ . }}</copyright>{{ end }}
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- with .OutputFormats.Get "rss" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q/>" .Permalink .MediaType.Type | safeHTML }}
    {{- end }}
    {{- range $champions }}
    {{- /* Their own site or profile, the same pick the map popup uses
           (partials/champion-url.html). The directory page is the fallback
           for the handful who record no link. */ -}}
    {{- $link := partial "champion-url.html" . | default $.Permalink -}}
    {{- $where := cond (ne (printf "%v" (.city | default "")) "") (printf "%s, %v" .city .country) (printf "%v" .country) -}}
    {{- $parts := slice (printf "Java Champion since %v" .year) -}}
    {{- with $where }}{{ $parts = $parts | append . }}{{ end -}}
    {{- /* status is a LIST upstream (emeritus, for instance) and is on 38 of
           422; the table shows it beside the name, so the feed says it too
           rather than presenting a retired champion as a current one. */ -}}
    {{- with .status }}{{ $parts = $parts | append (delimit . ", ") }}{{ end -}}
    <item>
      <title>{{ .name | transform.XMLEscape | safeHTML }}</title>
      <link>{{ $link }}</link>
      <pubDate>{{ (time.AsTime (printf "%v-01-01" .year)).Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- /* NOT the link: a champion with no profile falls back to this page's
             URL, which several would then share. Name plus year is unique and
             does not move when someone adds a website. */}}
      <guid isPermaLink="false">{{ printf "%s#%v-%s" $.Permalink .year (.name | urlize) | transform.XMLEscape | safeHTML }}</guid>
      <category>{{ .country | transform.XMLEscape | safeHTML }}</category>
      <description>{{ delimit $parts " · " | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
