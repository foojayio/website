{{- /*
  The site feed: the newest posts, and nothing else.

  Hugo's embedded RSS template ranges over the home page's .RegularPages,
  which is EVERY page on the site -- thousands of items, including dateless
  ones carrying `pubDate Mon, 01 Jan 0001`, which some aggregators drop.

  So: filtered to Section "posts", newest first, cut to [services.rss] limit
  -- the same value the section, term and per-author feeds honour.
*/ -}}
{{- $posts := where site.RegularPages "Section" "posts" -}}
{{- $posts = $posts.ByDate.Reverse -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 }}{{ $posts = $posts | first $limit }}{{ end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    {{- with (index $posts 0) }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "rss" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q/>" .Permalink .MediaType.Type | safeHTML }}
    {{- end }}
    {{- range $posts }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- range .Params.authors }}
      <dc:creator xmlns:dc="http://purl.org/dc/elements/1.1/">{{ with partial "author-page.html" . }}{{ .Title }}{{ else }}{{ . }}{{ end }}</dc:creator>
      {{- end }}
      {{- range .Params.categories }}
      <category>{{ . }}</category>
      {{- end }}
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Description | default .Summary | plainify | htmlUnescape | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
