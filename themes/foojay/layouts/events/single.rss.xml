{{- /*
  /calendar/'s feed: the next N events, soonest first.

  /calendar/ is a `page` kind, and [outputs] hands RSS to home/section/taxonomy/
  term as CLASSES of page -- so content/pages/calendar.md turns `rss` on for
  itself and this fills it. Hugo's embedded template ranges over .Pages, which
  a page kind does not have, and would ship an empty <channel>.

  N is [services.rss] limit, the same 30 every other feed here honours.

  EVERY EVENT COMES FROM partials/calendar-events.html, so the feed cannot
  disagree with the page it is a feed of. The filter is the same `end >= today`
  OVERLAP upcoming-events.html uses, not `start >= today`: a five-day
  conference that opened yesterday is still on.

  TWO THINGS AN ARTICLE FEED NEVER FACES:

  1. pubDate is the SYNC TIME, one value for every item, deliberately NOT the
     event's own start. A reader sorts pubDate descending, so dating items by
     their start puts the furthest-off event on top and buries next week's
     meetup -- the opposite of "the next 30 events". Readers dedupe on <guid>,
     so re-stamping pubDate cannot make a seen item unread again.

  2. So WHEN it is has to be in the item itself: the title leads with the date
     and the description spells it out INCLUDING THE UTC OFFSET, since a feed
     reader on another continent has none of the page's context.
*/ -}}
{{- $cal := partialCached "calendar-events.html" . -}}
{{- $today := now.Format "2006-01-02" -}}
{{- $upcoming := slice -}}
{{- range $cal.events -}}
  {{- $end := .endDate | default .date -}}
  {{- if ge $end $today -}}{{- $upcoming = $upcoming | append . -}}{{- end -}}
{{- end -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 }}{{ $upcoming = $upcoming | first $limit }}{{ end -}}
{{- /* The JUG sync stamp when there is one, so the feed says when it was last
       true rather than when this build ran; `now` only on a build with no synced
       data at all (a fork, or a first run before the sync). */ -}}
{{- $synced := now -}}
{{- with $cal.generatedAt }}{{ $synced = time.AsTime . }}{{ end -}}
{{- $pubDate := $synced.Format "Mon, 02 Jan 2006 15:04:05 -0700" -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Title }} on {{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ partial "meta-description.html" . }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    {{ with site.Copyright }}<copyright>{{ . }}</copyright>{{ end }}
    <lastBuildDate>{{ $pubDate | safeHTML }}</lastBuildDate>
    {{- with .OutputFormats.Get "rss" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q/>" .Permalink .MediaType.Type | safeHTML }}
    {{- end }}
    {{- range $upcoming }}
    {{- /* When it is, in words. A multi-day event names both ends; a timed one
           names the clock and its offset; an all-day one has only its date, and
           the date already says it. */ -}}
    {{- $when := .dateLabel -}}
    {{- if gt (len .days) 1 -}}
      {{- $when = printf "%s – %s" .dateLabel ((time.AsTime .endDate).Format "Monday, 2 January 2006") -}}
    {{- else if not .allDay -}}
      {{- $when = printf "%s, %s (%s)" .dateLabel .when .offsetLabel -}}
    {{- end -}}
    {{- $where := .place | default .placeShort | default .country -}}
    {{- $parts := (slice $when) -}}
    {{- with $where }}{{ $parts = $parts | append . }}{{ end -}}
    {{- /* The group -- only for a meetup, where it is the JUG's name. A
           hand-added entry's `group` is its type, which <category> already
           carries. */ -}}
    {{- if eq .kind "meetup" }}{{ with .group }}{{ $parts = $parts | append . }}{{ end }}{{ end -}}
    {{- /* The event's own page is the useful destination. A hand-added
           entry may carry no url, and then the calendar itself is. */ -}}
    {{- $link := .url | default $.Permalink -}}
    <item>
      <title>{{ printf "%s · %s" .dateShort .title | transform.XMLEscape | safeHTML }}</title>
      <link>{{ $link }}</link>
      <pubDate>{{ $pubDate | safeHTML }}</pubDate>
      {{- /* NOT the url: two entries can share one, and a guid has to
             be unique per item and stable across builds. */}}
      <guid isPermaLink="false">{{ printf "%s#%s" $link .startISO | transform.XMLEscape | safeHTML }}</guid>
      <category>{{ cond (eq .kind "meetup") "Meetup" (.type | default "Conference") }}</category>
      <description>{{ delimit $parts " · " | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
